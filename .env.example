# Copy to .env and replace every value before starting the application.
# Use a URL-safe database password (letters, numbers, underscores).
POSTGRES_PASSWORD=replace_with_unique_database_password
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
SEED_REQUESTER_PASSWORD=replace_with_unique_requester_password
SEED_AGENT_PASSWORD=replace_with_unique_agent_password
SEED_ADMIN_PASSWORD=replace_with_unique_admin_password
API_PORT=8080
FRONTEND_PORT=8081
